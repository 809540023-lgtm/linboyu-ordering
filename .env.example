# ===== 伺服器設定 =====
NODE_ENV=development
PORT=3000

# ===== 管理員認證 =====
# 簡單 token（開發用，生產應使用 JWT）
ADMIN_TOKEN=demo-admin-token
ADMIN_PASSWORD=demo123

# ===== 應用程式 URL =====
# 用於金流回調、LINE Webhook 等
APP_URL=http://localhost:3000

# ===== CORS 設定 =====
CORS_ORIGIN=*

# ===== NewebPay 金流設定 =====
# 從 NewebPay 管理後台取得
NEWEBPAY_MERCHANT_ID=your_merchant_id_here
NEWEBPAY_HASH_KEY=your_hash_key_here
NEWEBPAY_HASH_IV=your_hash_iv_here

# ===== LINE Messaging API 設定 =====
# 從 LINE Developers 取得
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# ===== ECPay（綠界）設定（選用）=====
ECPAY_MERCHANT_ID=your_ecpay_merchant_id
ECPAY_HASH_KEY=your_ecpay_hash_key
ECPAY_HASH_IV=your_ecpay_hash_iv

# ===== 資料庫 =====
# 通常不需要修改，預設使用 SQLite
DATABASE_PATH=./db/ordering.db

# ===== 日誌等級 =====
LOG_LEVEL=info
